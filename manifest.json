{
    "manifest_version": 3,
    "name": "TredoList BETA",
    "applications": {
        "gecko": {
            "id": "tredolist-firefox@netismic.com"
        }
    },
    "description": "THIS EXTENSION IS FOR BETA TESTING. TredoList turns Trello into a convenient todolist tool, by introducing new list layouts and dynamic color themes.",
    "version": "0.9.8",
    "author": "Olivier Cado",
    "icons": {
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "background": {
        "service_worker": "service_worker.js",
        "type": "module"
    },
    "permissions": [
        "scripting",
        "declarativeContent",
        "storage"
    ],
    "host_permissions": [
        "*://trello.com/b/*"
    ],
    "web_accessible_resources": [{
        "resources": [
            "css/layout.css",
            "css/theme-.css",
            "css/theme-bright.css",
            "css/theme-pastel.css",
            "css/theme-dark.css"
        ],
        "matches": [
            "*://trello.com/*"
        ]
    }],
    "action": {
        "default_title": "Tredolist",
        "default_popup": "config.html",
        "default_icon": {
            "19": "icon48.png",
            "38": "icon48.png",
            "48": "icon48.png"
        }
    }
}